# =============================================================================
# PiMonitor Development Environment Configuration
# =============================================================================
# This file contains development-specific overrides
# Copy to .env and customize for your development setup

# Development Environment Settings
ENVIRONMENT=development
INCLUDE_OPTIONAL=true

# Development Security (relaxed for local development)
GRAFANA_ADMIN_PASSWORD=admin
INFLUXDB_ADMIN_PASSWORD=admin123
INFLUXDB_ADMIN_TOKEN=dev-token-12345

# Development Ports (non-standard to avoid conflicts)
GRAFANA_PORT=3000
INFLUXDB_PORT=8086
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345

# Development Authentication
GRAFANA_ALLOW_SIGN_UP=true
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ORG_ROLE=Editor

# Development Logging (verbose for debugging)
LOG_LEVEL=debug
GRAFANA_LOG_LEVEL=debug
INFLUXDB_LOG_LEVEL=debug
PROMETHEUS_LOG_LEVEL=debug
LOKI_LOG_LEVEL=debug
ALLOY_LOG_LEVEL=debug
TELEGRAF_LOG_LEVEL=debug

# Development Features
DEV_ENABLE_DEBUG_LOGGING=true
DEV_ENABLE_PROFILING=true
DEV_ENABLE_METRICS_DEBUG=true
GRAFANA_FEATURE_TOGGLES=alertingSimplifiedRouting,alertingQueryAndExpressionsStepMode,publicDashboards

# Development Resource Limits (generous for development)
GRAFANA_MEMORY_LIMIT=1g
INFLUXDB_MEMORY_LIMIT=2g
PROMETHEUS_MEMORY_LIMIT=1g
LOKI_MEMORY_LIMIT=1g

# Development Data Retention (shorter for development)
INFLUXDB_INIT_RETENTION=7d
PROMETHEUS_RETENTION_TIME=7d
LOKI_RETENTION_PERIOD=7d

# Development Backup (disabled for development)
BACKUP_ENABLED=false
AUTO_CLEANUP_ENABLED=true
AUTO_UPDATE_ENABLED=false

# Development Monitoring
ENABLE_SELF_MONITORING=true
ENABLE_DETAILED_METRICS=true
RESOURCE_CHECK_INTERVAL=10s