# =============================================================================
# PiMonitor Staging Environment Configuration
# =============================================================================
# This file contains staging-specific overrides
# Staging environment for testing production configurations

# Staging Environment Settings
ENVIRONMENT=staging
INCLUDE_OPTIONAL=true

# Staging Security (production-like but with test credentials)
GRAFANA_ADMIN_PASSWORD=staging_admin_password
INFLUXDB_ADMIN_PASSWORD=staging_influx_password
INFLUXDB_ADMIN_TOKEN=staging_influx_token_12345

# Staging Ports (offset to avoid conflicts with development)
GRAFANA_PORT=3001
INFLUXDB_PORT=8087
PROMETHEUS_PORT=9091
LOKI_PORT=3101
ALLOY_PORT=12346

# Staging Authentication (production-like settings)
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_AUTO_ASSIGN_ORG_ROLE=Viewer

# Staging Logging (balanced between debug and performance)
LOG_LEVEL=info
GRAFANA_LOG_LEVEL=info
INFLUXDB_LOG_LEVEL=info
PROMETHEUS_LOG_LEVEL=info
LOKI_LOG_LEVEL=info
ALLOY_LOG_LEVEL=info
TELEGRAF_LOG_LEVEL=info

# Staging Features (test production feature set)
GRAFANA_FEATURE_TOGGLES=alertingSimplifiedRouting,alertingQueryAndExpressionsStepMode

# Staging Resource Limits (production-like but slightly more generous)
GRAFANA_MEMORY_LIMIT=768m
INFLUXDB_MEMORY_LIMIT=1.5g
PROMETHEUS_MEMORY_LIMIT=768m
LOKI_MEMORY_LIMIT=768m

# Staging Data Retention (medium retention for testing)
INFLUXDB_INIT_RETENTION=30d
PROMETHEUS_RETENTION_TIME=30d
LOKI_RETENTION_PERIOD=30d

# Staging Performance Settings
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
TELEGRAF_INTERVAL=15s

# Staging Backup (enabled for testing backup procedures)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 1 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false

# Staging Maintenance
AUTO_CLEANUP_ENABLED=true
CLEANUP_SCHEDULE=0 2 * * 0
AUTO_UPDATE_ENABLED=false

# Staging Monitoring
ENABLE_SELF_MONITORING=true
ENABLE_DETAILED_METRICS=true
RESOURCE_CHECK_INTERVAL=30s

# Staging Testing Features
TEST_MODE=false
TEST_DATA_ENABLED=true
DEV_ENABLE_DEBUG_LOGGING=false