# =============================================================================
# PiMonitor Production Environment Configuration
# =============================================================================
# This file contains production-specific overrides
# IMPORTANT: Update all passwords and tokens before deployment!

# Production Environment Settings
ENVIRONMENT=production
INCLUDE_OPTIONAL=false

# Production Security (strict security settings)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_STRONG_TOKEN

# Production Authentication
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_AUTO_ASSIGN_ORG_ROLE=Viewer

# Production Security Headers
GRAFANA_COOKIE_SECURE=true
GRAFANA_COOKIE_SAMESITE=strict
GRAFANA_CONTENT_TYPE_PROTECTION=true
GRAFANA_X_CONTENT_TYPE_OPTIONS=nosniff
GRAFANA_X_XSS_PROTECTION=true

# Production Logging (optimized for performance)
LOG_LEVEL=warn
GRAFANA_LOG_LEVEL=warn
INFLUXDB_LOG_LEVEL=warn
PROMETHEUS_LOG_LEVEL=warn
LOKI_LOG_LEVEL=warn
ALLOY_LOG_LEVEL=warn
TELEGRAF_LOG_LEVEL=warn

# Production Features (minimal feature set)
GRAFANA_FEATURE_TOGGLES=alertingSimplifiedRouting
GRAFANA_PLUGIN_ADMIN_ENABLED=false
GRAFANA_PLUGIN_ADMIN_EXTERNAL_MANAGE_ENABLED=false

# Production Resource Limits (optimized for Raspberry Pi)
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_MEMORY_RESERVATION=256m
INFLUXDB_MEMORY_LIMIT=1g
INFLUXDB_MEMORY_RESERVATION=512m
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_MEMORY_RESERVATION=256m
LOKI_MEMORY_LIMIT=512m
LOKI_MEMORY_RESERVATION=256m

# Production CPU Limits
GRAFANA_CPU_LIMIT=0.5
INFLUXDB_CPU_LIMIT=0.5
PROMETHEUS_CPU_LIMIT=0.5
LOKI_CPU_LIMIT=0.5

# Production Data Retention (longer retention)
INFLUXDB_INIT_RETENTION=90d
PROMETHEUS_RETENTION_TIME=90d
PROMETHEUS_RETENTION_SIZE=10GB
LOKI_RETENTION_PERIOD=90d

# Production Performance Settings
PROMETHEUS_SCRAPE_INTERVAL=30s
PROMETHEUS_EVALUATION_INTERVAL=30s
TELEGRAF_INTERVAL=30s
LOKI_INGESTION_RATE_MB=16
LOKI_INGESTION_BURST_SIZE_MB=32

# Production Backup (enabled with encryption)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true

# Production Maintenance
AUTO_CLEANUP_ENABLED=true
CLEANUP_SCHEDULE=0 3 * * 0
CLEANUP_UNUSED_IMAGES=true
CLEANUP_UNUSED_VOLUMES=false

# Production Updates (manual updates recommended)
AUTO_UPDATE_ENABLED=false
UPDATE_NOTIFICATION_ENABLED=true

# Production Monitoring
ENABLE_SELF_MONITORING=true
ENABLE_DETAILED_METRICS=false
RESOURCE_CHECK_INTERVAL=60s
MEMORY_WARNING_THRESHOLD=85
DISK_WARNING_THRESHOLD=90
CPU_WARNING_THRESHOLD=85

# Production Restart Policy
RESTART_POLICY=always
DEPLOY_TIMEOUT=600
HEALTH_CHECK_TIMEOUT=180

# Production Disable Development Features
DEV_ENABLE_DEBUG_LOGGING=false
DEV_ENABLE_PROFILING=false
DEV_ENABLE_METRICS_DEBUG=false
DEV_DISABLE_AUTH=false
TEST_MODE=false