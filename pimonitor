        show_compact_header "Configuration Management"
        
        local options=(
            "Generate Secrets"
            "Validate Configuration"
            "Manage Environment"
            "Edit Configuration Files"
            "Show Current Config"
            "Back to Main Menu"
        )
        
        echo "Select configuration operation:"
        echo
        
        select choice in "${options[@]}"; do
            case $REPLY in
                1)
                    show_progress "Generating secrets"
                    if "$SCRIPT_DIR/scripts/generate-secrets.sh"; then
                        show_success "Secrets generated successfully"
                    else
                        show_error "Failed to generate secrets"
                    fi
                    pause_for_user
                    break
                    ;;
                2)
                    show_progress "Validating configuration"
                    if "$SCRIPT_DIR/scripts/validate-config.sh"; then
                        show_success "Configuration is valid"
                    else
                        show_error "Configuration validation failed"
                    fi
                    pause_for_user
                    break
                    ;;
                3)
                    environment_submenu
                    break
                    ;;
                4)
                    show_progress "Opening configuration manager"
                    "$SCRIPT_DIR/scripts/config-manager.sh"
                    pause_for_user
