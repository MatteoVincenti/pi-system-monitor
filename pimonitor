# Backup restore submenu
backup_restore_submenu() {
    while true; do
        clear
        show_compact_header "Backup & Restore"
        
        echo "Available backups:"
        if [[ -d "$PROJECT_ROOT/backups" ]]; then
            ls -1 "$PROJECT_ROOT/backups/" 2>/dev/null || echo "No backups found"
        else
            echo "No backup directory found"
        fi
        echo
        
        local options=(
            "Create New Backup"
            "Restore from Backup"
            "List Backup Details"
            "Back to Maintenance Menu"
        )
        
        echo "Select backup operation:"
        echo
        
        select choice in "${options[@]}"; do
            case $REPLY in
                1)
                    read -p "Enter backup name (or press Enter for auto-generated): " backup_name
                    show_progress "Creating backup: ${backup_name:-auto-generated}"
                    if "$SCRIPT_DIR/scripts/deploy.sh" backup "$backup_name"; then
                        show_success "Backup created successfully"
                    else
                        show_error "Backup creation failed"
                    fi
                    pause_for_user
                    break
                    ;;
                2)
                    read -p "Enter backup name to restore: " backup_name
                    if [[ -n "$backup_name" ]]; then
                        show_warning "This will overwrite current data!"
                        read -p "Are you sure? (y/N): " confirm
                        if [[ "$confirm" =~ ^[Yy]$ ]]; then
                            show_progress "Restoring from backup: $backup_name"
                            if "$SCRIPT_DIR/scripts/deploy.sh" restore "$backup_name"; then
                                show_success "Restore completed successfully"
                            else
                                show_error "Restore failed"
                            fi
                        else
                            show_info "Restore cancelled"
                        fi
                    else
                        show_error "Backup name required"
                    fi
                    pause_for_user
                    break
                    ;;
                3)
                    read -p "Enter backup name to inspect: " backup_name
                    if [[ -n "$backup_name" ]] && [[ -f "$PROJECT_ROOT/backups/$backup_name/manifest.txt" ]]; then
                        echo
                        cat "$PROJECT_ROOT/backups/$backup_name/manifest.txt"
                    else
                        show_error "Backup not found or no manifest available"
                    fi
                    pause_for_user
                    break
                    ;;
                4) return ;;
                *)
                    show_error "Invalid selection. Please choose 1-4."
                    echo
                    ;;
            esac
        done
    done
}

# Show system status
show_system_status() {
    clear
    show_compact_header "System Status"
    
    show_progress "Loading system status"
    "$SCRIPT_DIR/scripts/deploy.sh" status
    
    echo
    pause_for_user
}

# =============================================================================
# Utility Functions
# =============================================================================

# Pause for user input
pause_for_user() {
    echo
    read -p "Press Enter to continue..." -r
}

# Handle script interruption
cleanup() {
    echo
    show_info "PiMonitor management interface interrupted"
    exit 0
}

# =============================================================================
# Main Function
# =============================================================================

main() {
    # Set up signal handlers
    trap cleanup SIGINT SIGTERM
    
    # Check if running with arguments (non-interactive mode)
    if [[ $# -gt 0 ]]; then
        case "$1" in
            --help|-h)
                show_pimonitor_logo
                echo "PiMonitor Management Interface"
                echo
                echo "Usage:"
                echo "  $0           # Interactive menu mode"
                echo "  $0 --help    # Show this help"
                echo "  $0 --version # Show version"
                echo
                echo "For direct command execution, use:"
                echo "  ./scripts/deploy.sh <command>"
                echo "  ./scripts/setup.sh"
                echo "  ./maintenance.sh"
                echo "  ./utilities.sh"
                exit 0
                ;;
            --version|-v)
                show_pimonitor_logo
                exit 0
                ;;
            *)
                show_error "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    fi
    
    # Validate prerequisites
    if [[ ! -f "$PROJECT_ROOT/.env" ]]; then
        show_warning "Environment file not found. Run setup first."
        read -p "Would you like to run setup now? (y/N): " run_setup
        if [[ "$run_setup" =~ ^[Yy]$ ]]; then
            "$SCRIPT_DIR/scripts/setup.sh"
        else
            show_error "Setup required before using PiMonitor"
            exit 1
        fi
    fi
    
    # Start main menu
    main_menu
}

# Run main function
main "$@"