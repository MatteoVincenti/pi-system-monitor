#!/bin/bash

# PiMonitor Main Management Interface
# Interactive menu system for managing PiMonitor services

set -e

# Determine script directory and project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

# Override SCRIPT_DIR for library sourcing to avoid path conflicts
LIB_SCRIPT_DIR="$SCRIPT_DIR"

# Source shared libraries
# shellcheck source=./scripts/lib/common.sh
source "$LIB_SCRIPT_DIR/scripts/lib/common.sh"
# shellcheck source=./scripts/lib/branding.sh
source "$LIB_SCRIPT_DIR/scripts/lib/branding.sh"
# shellcheck source=./scripts/lib/docker.sh
source "$LIB_SCRIPT_DIR/scripts/lib/docker.sh"

# Configuration
readonly PIMONITOR_VERSION="2.0.0"
readonly MENU_TIMEOUT=30

# Initialize branding system
init_branding

# =============================================================================
# Menu Functions
# =============================================================================

# Main menu
main_menu() {
    while true; do
        clear
        show_pimonitor_logo
        
        echo -e "${WHITE}${BOLD}Main Menu${NC}"
        show_separator
        
        local options=(
            "Deployment Operations"
            "Configuration Management" 
            "System Operations"
            "Maintenance Tasks"
            "View System Status"
            "Exit"
        )
        
        echo "Please select an option:"
        echo
        
        select choice in "${options[@]}"; do
            case $REPLY in
                1) deployment_menu; break ;;
                2) configuration_menu; break ;;
                3) system_menu; break ;;
                4) maintenance_menu; break ;;
                5) show_system_status; break ;;
                6) 
                    echo
                    show_info "Thank you for using PiMonitor!"
                    exit 0
                    ;;
                *)
                    show_error "Invalid selection. Please choose 1-6."
                    echo
                    ;;
            esac
        done
    done
}

# Deployment operations menu
deployment_menu() {
    while true; do
        clear
        show_compact_header "Deployment Operations"
        
        local options=(
            "Start Services"
            "Stop Services"
            "Restart Services"
            "Deploy Configuration"
            "Update Services"
            "Back to Main Menu"
        )
        
        echo "Select deployment operation:"
        echo
        
        select choice in "${options[@]}"; do
            case $REPLY in
                1) 
                    show_progress "Starting PiMonitor services"
                    if "$SCRIPT_DIR/scripts/deploy.sh" start; then
                        show_success "Services started successfully"
                    else
                        show_error "Failed to start services"
                    fi
                    pause_for_user
                    break
                    ;;
                2)
                    show_progress "Stopping PiMonitor services"
                    if "$SCRIPT_DIR/scripts/deploy.sh" stop; then
                        show_success "Services stopped successfully"
                    else
                        show_error "Failed to stop services"
                    fi
                    pause_for_user
                    break
                    ;;
                3)
                    show_progress "Restarting PiMonitor services"
                    if "$SCRIPT_DIR/scripts/deploy.sh" restart; then
                        show_success "Services restarted successfully"
                    else
                        show_error "Failed to restart services"
                    fi
                    pause_for_user
                    break
                    ;;
                4)
                    show_progress "Deploying configuration"
                    if "$SCRIPT_DIR/scripts/deploy.sh" start -e production; then
                        show_success "Configuration deployed successfully"
                    else
                        show_error "Failed to deploy configuration"
                    fi
                    pause_for_user
                    break
                    ;;
                5)
                    show_progress "Updating services"
                    if "$SCRIPT_DIR/scripts/deploy.sh" update; then
                        show_success "Services updated successfully"
                    else
                        show_error "Failed to update services"
                    fi
                    pause_for_user
                    break
                    ;;
                6) return ;;
                *)
                    show_error "Invalid selection. Please choose 1-6."
                    echo
                    ;;
            esac
        done
    done
}

# Configuration management menu
