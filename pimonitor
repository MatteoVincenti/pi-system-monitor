    done
}

# Environment management submenu
environment_submenu() {
    while true; do
        clear
        show_compact_header "Environment Management"
        
        local current_env="${ENVIRONMENT:-development}"
        echo -e "Current Environment: ${GREEN}${current_env}${NC}"
        echo
        
        local options=(
            "Switch to Development"
            "Switch to Production"
            "Switch to Staging"
            "Include Optional Services"
            "Back to Configuration Menu"
        )
        
        echo "Select environment option:"
        echo
        
        select choice in "${options[@]}"; do
            case $REPLY in
                1)
                    export ENVIRONMENT="development"
                    show_success "Switched to development environment"
                    pause_for_user
                    break
                    ;;
                2)
                    export ENVIRONMENT="production"
                    show_success "Switched to production environment"
                    pause_for_user
                    break
                    ;;
                3)
                    export ENVIRONMENT="staging"
                    show_success "Switched to staging environment"
                    pause_for_user
                    break
                    ;;
                4)
                    export INCLUDE_OPTIONAL="true"
                    show_success "Optional services will be included"
                    pause_for_user
                    break
                    ;;
                5) return ;;
                *)
                    show_error "Invalid selection. Please choose 1-5."
                    echo
                    ;;
            esac
        done
    done
}

