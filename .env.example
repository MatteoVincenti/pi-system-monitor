# =============================================================================
# PiMonitor Environment Configuration Template
# =============================================================================
# This file contains all available configuration options for PiMonitor
# Copy this file to .env and customize the values for your environment
# 
# Configuration Validation: Run ./scripts/deploy.sh validate
# Generate Secrets: Run ./scripts/generate-secrets.sh
# 
# Environment Types:
#   - development: Local development with debug logging and relaxed security
#   - production:  Production deployment with optimized performance and security
#   - staging:     Staging environment for testing production configurations

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Project and Environment Settings
COMPOSE_PROJECT_NAME=pimonitor
ENVIRONMENT=development
INCLUDE_OPTIONAL=false

# Deployment Configuration
DEPLOY_TIMEOUT=300
HEALTH_CHECK_TIMEOUT=120
RESTART_POLICY=unless-stopped

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Service Ports (ensure these don't conflict with other services)
GRAFANA_PORT=3000
INFLUXDB_PORT=8086
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
TELEGRAF_PORT=8125

# Optional Service Ports
PORTAINER_HTTP_PORT=8000
PORTAINER_HTTPS_PORT=9443

# Network Settings
MONITORING_NETWORK=pimonitor_monitoring
ENABLE_IPV6=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Authentication and Authorization
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password
GRAFANA_ADMIN_PASSWORD_FILE=/run/secrets/grafana_admin_password

# InfluxDB Authentication
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme_influxdb_password
INFLUXDB_ADMIN_TOKEN=changeme_influxdb_token
INFLUXDB_ADMIN_TOKEN_FILE=/run/secrets/influxdb_admin_token

# Security Settings
ENABLE_HTTPS=false
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key
FORCE_HTTPS_REDIRECT=false

# Session and Cookie Security
SESSION_TIMEOUT=24h
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================

# Basic Settings
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_SERVE_FROM_SUB_PATH=false

# Authentication Settings
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_ALLOW_ORG_CREATE=false
GRAFANA_AUTO_ASSIGN_ORG=true
GRAFANA_AUTO_ASSIGN_ORG_ROLE=Viewer

# Anonymous Access
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_ANONYMOUS_ORG_NAME=Main Org.
GRAFANA_ANONYMOUS_ORG_ROLE=Viewer

# Security Settings
GRAFANA_DISABLE_GRAVATAR=true
GRAFANA_COOKIE_SECURE=false
GRAFANA_COOKIE_SAMESITE=lax
GRAFANA_CONTENT_TYPE_PROTECTION=true
GRAFANA_X_CONTENT_TYPE_OPTIONS=nosniff
GRAFANA_X_XSS_PROTECTION=true

# Feature Toggles
GRAFANA_FEATURE_TOGGLES=alertingSimplifiedRouting,alertingQueryAndExpressionsStepMode

# Plugin Configuration
GRAFANA_INSTALL_PLUGINS=
GRAFANA_PLUGIN_ADMIN_ENABLED=true
GRAFANA_PLUGIN_ADMIN_EXTERNAL_MANAGE_ENABLED=false

# Logging
GRAFANA_LOG_LEVEL=info
GRAFANA_LOG_MODE=console,file
GRAFANA_LOG_FILTERS=

# =============================================================================
# INFLUXDB CONFIGURATION
# =============================================================================

# Database Settings
INFLUXDB_HOST=influxdb
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=changeme_influxdb_password
INFLUXDB_INIT_ORG=pimonitor
INFLUXDB_INIT_BUCKET=telegraf
INFLUXDB_INIT_RETENTION=30d
INFLUXDB_INIT_ADMIN_TOKEN=changeme_influxdb_token

# Performance Settings
INFLUXDB_BOLT_PATH=/var/lib/influxdb2/influxd.bolt
INFLUXDB_ENGINE_PATH=/var/lib/influxdb2/engine
INFLUXDB_REPORTING_DISABLED=true

# Query Settings
INFLUXDB_QUERY_CONCURRENCY=10
INFLUXDB_QUERY_QUEUE_SIZE=10
INFLUXDB_QUERY_MEMORY_BYTES=0

# Logging
INFLUXDB_LOG_LEVEL=info

# =============================================================================
# PROMETHEUS CONFIGURATION
# =============================================================================

# Basic Settings
PROMETHEUS_HOST=prometheus
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# Storage Settings
PROMETHEUS_STORAGE_TSDB_PATH=/prometheus
PROMETHEUS_STORAGE_TSDB_RETENTION_TIME=30d
PROMETHEUS_STORAGE_TSDB_RETENTION_SIZE=10GB

# Query Settings
PROMETHEUS_QUERY_TIMEOUT=2m
PROMETHEUS_QUERY_MAX_CONCURRENCY=20
PROMETHEUS_QUERY_MAX_SAMPLES=50000000

# Web Settings
PROMETHEUS_WEB_ENABLE_LIFECYCLE=true
PROMETHEUS_WEB_ENABLE_ADMIN_API=false
PROMETHEUS_WEB_EXTERNAL_URL=http://localhost:9090

# Logging
PROMETHEUS_LOG_LEVEL=info
PROMETHEUS_LOG_FORMAT=logfmt

# =============================================================================
# LOKI CONFIGURATION
# =============================================================================

# Basic Settings
LOKI_HOST=loki
LOKI_HTTP_PORT=3100
LOKI_GRPC_PORT=9096

# Storage Settings
LOKI_STORAGE_TYPE=filesystem
LOKI_STORAGE_PATH=/loki
LOKI_RETENTION_PERIOD=30d

# Performance Settings
LOKI_INGESTION_RATE_MB=32
LOKI_INGESTION_BURST_SIZE_MB=64
LOKI_MAX_STREAMS_PER_USER=10000
LOKI_MAX_LINE_SIZE=256000

# Query Settings
LOKI_QUERY_TIMEOUT=1m
LOKI_MAX_QUERY_PARALLELISM=32
LOKI_MAX_QUERY_SERIES=500

# Logging
LOKI_LOG_LEVEL=info
LOKI_LOG_FORMAT=logfmt

# =============================================================================
# ALLOY CONFIGURATION
# =============================================================================

# Basic Settings
ALLOY_HOST=alloy
ALLOY_HTTP_PORT=12345
ALLOY_STORAGE_PATH=/var/lib/alloy

# Log Collection Settings
ALLOY_LOG_LEVEL=info
ALLOY_ENABLE_FEATURES=

# Targets
ALLOY_LOKI_ENDPOINT=http://loki:3100/loki/api/v1/push
ALLOY_PROMETHEUS_ENDPOINT=http://prometheus:9090/api/v1/write

# =============================================================================
# TELEGRAF CONFIGURATION
# =============================================================================

# Basic Settings
TELEGRAF_HOST=telegraf
TELEGRAF_HOSTNAME=
TELEGRAF_INTERVAL=10s
TELEGRAF_ROUND_INTERVAL=true
TELEGRAF_METRIC_BATCH_SIZE=1000
TELEGRAF_METRIC_BUFFER_LIMIT=10000

# Collection Settings
TELEGRAF_COLLECTION_JITTER=0s
TELEGRAF_FLUSH_INTERVAL=10s
TELEGRAF_FLUSH_JITTER=0s

# Precision Settings
TELEGRAF_PRECISION=
TELEGRAF_LOGFILE=
TELEGRAF_LOGFILE_ROTATION_INTERVAL=0d
TELEGRAF_LOGFILE_ROTATION_MAX_SIZE=0MB
TELEGRAF_LOGFILE_ROTATION_MAX_ARCHIVES=5

# Debug Settings
TELEGRAF_DEBUG=false
TELEGRAF_QUIET=false

# =============================================================================
# RESOURCE LIMITS AND PERFORMANCE
# =============================================================================

# Memory Limits (adjust based on your system capabilities)
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_MEMORY_RESERVATION=256m
INFLUXDB_MEMORY_LIMIT=1g
INFLUXDB_MEMORY_RESERVATION=512m
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_MEMORY_RESERVATION=256m
LOKI_MEMORY_LIMIT=512m
LOKI_MEMORY_RESERVATION=256m
ALLOY_MEMORY_LIMIT=256m
ALLOY_MEMORY_RESERVATION=128m
TELEGRAF_MEMORY_LIMIT=256m
TELEGRAF_MEMORY_RESERVATION=128m

# CPU Limits
GRAFANA_CPU_LIMIT=0.5
GRAFANA_CPU_RESERVATION=0.25
INFLUXDB_CPU_LIMIT=0.5
INFLUXDB_CPU_RESERVATION=0.25
PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_CPU_RESERVATION=0.25
LOKI_CPU_LIMIT=0.5
LOKI_CPU_RESERVATION=0.25
ALLOY_CPU_LIMIT=0.25
ALLOY_CPU_RESERVATION=0.1
TELEGRAF_CPU_LIMIT=0.25
TELEGRAF_CPU_RESERVATION=0.1

# System Resource Monitoring
ENABLE_RESOURCE_MONITORING=true
RESOURCE_CHECK_INTERVAL=30s
MEMORY_WARNING_THRESHOLD=80
DISK_WARNING_THRESHOLD=85
CPU_WARNING_THRESHOLD=80

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Global Log Settings
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE=100m
LOG_MAX_FILES=5

# Service-specific Log Levels
GRAFANA_LOG_LEVEL=info
INFLUXDB_LOG_LEVEL=info
PROMETHEUS_LOG_LEVEL=info
LOKI_LOG_LEVEL=info
ALLOY_LOG_LEVEL=info
TELEGRAF_LOG_LEVEL=info

# Loki Docker Driver Settings
LOKI_DRIVER_URL=http://loki:3100/loki/api/v1/push
LOKI_DRIVER_MAX_RETRIES=3
LOKI_DRIVER_TIMEOUT=10s

# Metrics Collection
ENABLE_SELF_MONITORING=true
METRICS_RETENTION_PERIOD=30d
ENABLE_DETAILED_METRICS=false

# =============================================================================
# BACKUP AND MAINTENANCE
# =============================================================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false

# Maintenance Settings
AUTO_CLEANUP_ENABLED=true
CLEANUP_SCHEDULE=0 3 * * 0
CLEANUP_UNUSED_IMAGES=true
CLEANUP_UNUSED_VOLUMES=false
CLEANUP_UNUSED_NETWORKS=true

# Update Settings
AUTO_UPDATE_ENABLED=false
UPDATE_SCHEDULE=0 4 * * 0
UPDATE_NOTIFICATION_ENABLED=true

# =============================================================================
# OPTIONAL SERVICES CONFIGURATION
# =============================================================================

# Portainer Settings
PORTAINER_ADMIN_PASSWORD=changeme_portainer_password
PORTAINER_LOGO_URL=
PORTAINER_TEMPLATES_URL=

# Watchtower Settings
WATCHTOWER_POLL_INTERVAL=3600
WATCHTOWER_CLEANUP=true
WATCHTOWER_REMOVE_VOLUMES=false
WATCHTOWER_INCLUDE_STOPPED=true
WATCHTOWER_INCLUDE_RESTARTING=false
WATCHTOWER_NO_STARTUP_MESSAGE=false
WATCHTOWER_SCHEDULE=0 0 3 * * *
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=

# =============================================================================
# DEVELOPMENT AND DEBUGGING
# =============================================================================

# Development Settings (only for ENVIRONMENT=development)
DEV_ENABLE_DEBUG_LOGGING=true
DEV_ENABLE_PROFILING=false
DEV_ENABLE_METRICS_DEBUG=false
DEV_DISABLE_AUTH=false
DEV_MOCK_DATA_ENABLED=false

# Debug Ports (only exposed in development)
GRAFANA_DEBUG_PORT=2345
PROMETHEUS_DEBUG_PORT=2346
LOKI_DEBUG_PORT=2347

# Testing Settings
TEST_MODE=false
TEST_DATA_ENABLED=false
TEST_SKIP_MIGRATIONS=false

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Time Zone Settings
TZ=UTC
GRAFANA_DEFAULT_TIMEZONE=browser
INFLUXDB_TZ=UTC

# Locale Settings
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# Custom Configuration Paths
CUSTOM_CONFIG_PATH=./configs/custom
CUSTOM_DASHBOARDS_PATH=./configs/grafana/dashboards/custom
CUSTOM_ALERTS_PATH=./configs/grafana/provisioning/alerting/custom

# External Integrations
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PiMonitor

# =============================================================================
# VALIDATION AND CONSTRAINTS
# =============================================================================

# Port Range Validation (ports must be within these ranges)
MIN_PORT=1024
MAX_PORT=65535

# Resource Validation (minimum system requirements)
MIN_MEMORY_GB=2
MIN_DISK_GB=10
MIN_CPU_CORES=1

# Security Validation
MIN_PASSWORD_LENGTH=12
REQUIRE_STRONG_PASSWORDS=true
PASSWORD_COMPLEXITY_ENABLED=true

# =============================================================================
# CONFIGURATION NOTES AND HELP
# =============================================================================

# Configuration Validation:
#   Run: ./scripts/deploy.sh validate
#   This will check all environment variables and configuration files

# Security Setup:
#   1. Run: ./scripts/generate-secrets.sh
#   2. Update passwords and tokens in this file
#   3. Set appropriate file permissions: chmod 600 .env

# Performance Tuning:
#   - Adjust memory limits based on your system capacity
#   - Monitor resource usage with: ./scripts/deploy.sh status
#   - Use production environment for optimal performance

# Troubleshooting:
#   - Check logs: ./scripts/logs.sh [service]
#   - Validate config: ./scripts/deploy.sh validate
#   - View service status: ./scripts/deploy.sh status

# Environment-specific Configurations:
#   - Copy this file to .env.development, .env.production, etc.
#   - Use ENVIRONMENT variable to select configuration
#   - Override specific values as needed

# =============================================================================
# SECURITY WARNINGS
# =============================================================================

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit the .env file to version control
# 2. Change ALL default passwords before deployment
# 3. Use strong, unique passwords for each service
# 4. Generate secure tokens with: openssl rand --hex 32
# 5. Regularly rotate passwords and tokens
# 6. Enable HTTPS in production environments
# 7. Restrict network access to monitoring ports
# 8. Keep Docker and all images updated
# 9. Monitor logs for security events
# 10. Use secrets management in production